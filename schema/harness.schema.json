{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Edvantage26/jig/main/schema/harness.schema.json",
  "title": "jig harness.json",
  "description": "Per-repo contract read by the jig hooks (.claude/harness.json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Contract version."
    },
    "features": {
      "type": "object",
      "description": "Features enabled in this repo. Omitted features use their default (okf and danger: on).",
      "additionalProperties": false,
      "properties": {
        "okf": {
          "type": "boolean",
          "default": true,
          "description": "OKF project knowledge: index at session start, upkeep reminder at stop, /jig:okf and /jig:validate skills."
        },
        "danger": {
          "type": "boolean",
          "default": true,
          "description": "Confirm or refuse destructive shell commands."
        }
      }
    },
    "trunk": {
      "type": "string",
      "minLength": 1,
      "default": "main",
      "description": "Protected branch."
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Commands that must pass before the agent calls a change done."
    },
    "knowledge": {
      "type": [
        "string",
        "null"
      ],
      "default": ".okf",
      "description": "Path of the OKF knowledge bundle (default .okf)."
    },
    "modules": {
      "type": "object",
      "description": "Per-module switch (true/false) or options object (with optional enabled).",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "properties": {
        "brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "danger": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_rules": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "git-skip-hooks",
                      "git-reset-hard",
                      "git-force-push",
                      "git-clean",
                      "git-discard-changes",
                      "rm-recursive-force",
                      "sql-destructive",
                      "docker-destructive",
                      "disk-destroy"
                    ]
                  }
                }
              }
            }
          ]
        },
        "okf-index": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-upkeep": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    }
  }
}
